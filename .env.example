# Copy to .env.local for development. Never commit real values.
# Use a NEW Appwrite project for this system. Never reuse REC's project, database or keys.

APP_URL=http://localhost:3000

# Appwrite (server only; there are deliberately no NEXT_PUBLIC_ variables)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=events
# Runtime key: scopes documents.read and documents.write only.
APPWRITE_API_KEY=
# Setup key for scripts/setup-appwrite.mjs only (adds databases/collections scopes).
# Keep it on the admin's machine, not on the server.
APPWRITE_SETUP_API_KEY=

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Email: smtp | http | console (console = local development only)
EMAIL_TRANSPORT=console
EMAIL_FROM="NREP Events <events@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For EMAIL_TRANSPORT=http: an endpoint that accepts { email, subject, text, html }
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
