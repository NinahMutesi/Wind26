# Copy to .env.local for development. Never commit real values.
# Use a NEW Appwrite project for this system. Never reuse REC's project, database or keys.

APP_URL=http://localhost:3000

# Appwrite (server only; there are deliberately no NEXT_PUBLIC_ variables)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1 https://appwrite.nrep.ug/v1/account
APPWRITE_PROJECT_ID=6ae9e952000bddca06f7
APPWRITE_DATABASE_ID=events 6ae9ea17002cfd7fbc3b
# Runtime key: scopes rows.read and rows.write only.
APPWRITE_API_KEY= 6ae9ea17002cfd7fbc3b
# Setup key for scripts/setup-appwrite.mjs only: databases, tables, columns and indexes (read and write).
# Keep it on the admin's machine, not on the server.
APPWRITE_SETUP_API_KEY=

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# signin (default): staff sign in with an emailed code.
# password: one shared admin password (ADMIN_PASSWORD, 12+ characters). No email needed to sign in.
# open: no sign-in, for running the event from one computer. Refused unless APP_URL is localhost
# and NODE_ENV is not production.
ADMIN_ACCESS=signin
ADMIN_PASSWORD=

# Email: smtp | http | console | none (console = local development only; none = not set up yet)
EMAIL_TRANSPORT=console
EMAIL_FROM="NREP Events <events@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For EMAIL_TRANSPORT=http: an endpoint that accepts { email, subject, text, html }
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
