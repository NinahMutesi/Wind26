      "font": "GreatVibes-Regular",
      "sizePt": 44,
      "minSizePt": 26,
      "maxLines": 1,
      "color": "#F0941C",
      "x": 48,
      "width": 181,
      "baseline": 133.5,
      "align": "center"
    },
    {
