      "minSizePt": 5,
      "color": "#4A5560",
      "x": 118.5,
      "width": 80,
      "baseline": 196,
      "align": "center"
    },
    {
      "type": "text",
      "value": "ID {certificateId}",
      "font": "Poppins-Regular",
      "sizePt": 5.5,
      "minSizePt": 4.5,
      "color": "#4A5560",
      "x": 118.5,
      "width": 80,
      "baseline": 199,
      "align": "center"
    }
  ]
}
